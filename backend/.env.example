# backend/.env.example

# Backend runtime
DATABASE_URL=mysql+pymysql://counselor_app:counselor_pass@localhost/career_counselor
ONET_API_TIMEOUT=15

# AI gateway
# AI_ENABLED: Set to true to enable AI features.
AI_ENABLED=true
# AI_PROVIDER: Can be "openai", "anthropic", "openrouter", or "opencode-zen".
# This determines which provider configuration is primarily used.
AI_PROVIDER=openrouter
# AI_MODEL: Default model to use if a provider-specific model isn't set,
# or for providers that only have one model.
AI_MODEL=openai/gpt-3.5-turbo
# AI_TIMEOUT_SECONDS: Timeout for AI API calls in seconds.
AI_TIMEOUT_SECONDS=8
# AI_MAX_TOKENS: Maximum tokens for AI responses.
AI_MAX_TOKENS=1200
# AI_ASSESSMENT_ENABLED: Set to true to enable AI reasoning in career assessments.
AI_ASSESSMENT_ENABLED=false

# --- OpenAI Configuration ---
# Your OpenAI API Key.
OPENAI_API_KEY=
# OpenAI API Endpoint.
OPENAI_API_ENDPOINT=https://api.openai.com/v1
# OpenAI model to use. For free/low-cost: 'gpt-3.5-turbo' or similar.
OPENAI_MODEL=gpt-3.5-turbo

# --- Anthropic Configuration ---
# Your Anthropic API Key.
ANTHROPIC_API_KEY=
# Anthropic API Endpoint.
ANTHROPIC_API_ENDPOINT=https://api.anthropic.com
# Anthropic model to use. For free/low-cost: 'claude-3-haiku-20240307' or similar.
ANTHROPIC_MODEL=claude-3-haiku-20240307
# Anthropic API version.
ANTHROPIC_VERSION=2023-06-01

# --- OpenRouter Configuration ---
# Your OpenRouter API Key.
OPENROUTER_API_KEY=
# OpenRouter API Endpoint.
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1
# OpenRouter model to use. Many options, often cheaper:
# e.g., "openai/gpt-3.5-turbo", "deepseek/deepseek-chat", "nousresearch/nous-hermes-2-mixtral-8x7b-sft"
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# --- Opencode-Zen Configuration (Assuming OpenAI-compatible) ---
# If AI_PROVIDER is set to "opencode-zen", this model will be used.
# The API_KEY is expected to be picked up from ~/.local/share/opencode/auth.json
# Example free/low-cost model: "deepseek-v4-flash-free"
# You might need to specify an endpoint if opencode-zen isn't directly compatible with OpenRouter's.
# OPENCODE_ZEN_API_ENDPOINT=https://api.opencode-zen.com/v1